rules_version = '2';

// ผู้ใช้ที่เข้าสู่ระบบแล้ว (มี Firebase ID token ที่ถูกต้อง) อ่าน/เขียนได้ทุก document
// ผู้ที่ยังไม่เข้าสู่ระบบถูกปฏิเสธทั้งหมด
//
// หมายเหตุ: กฎนี้กว้างกว่า docs/02-design/02-technical/ACL.md และ db-spec.md — ไม่ตรวจ role,
// isActive, email_verified หรือ PatientAssignment และ Client เขียน users/{uid}, auditLogRecords
// ได้เอง กฎเดิมตาม db-spec อยู่ใน git history (commit a804d30)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
