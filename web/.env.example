# คัดลอกเป็น .env.local แล้วเติมค่า Web app config จาก Firebase Console > Project settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=track-ncds.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=track-ncds
VITE_FIREBASE_APP_ID=
# true = ต่อ Firebase Emulator Suite (ต้องรัน firebase emulators:start ก่อน)
VITE_USE_EMULATORS=false
# หน้าทดสอบ AI /dev/ai-test (เฉพาะ npm run dev — ไม่ถูก build ลงเว็บจริง) ใส่คีย์ใน .env.local เท่านั้น ห้าม commit
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=google/gemini-2.5-flash-lite
