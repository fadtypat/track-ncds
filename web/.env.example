# คัดลอกเป็น .env.local แล้วเติมค่า Web app config จาก Firebase Console > Project settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=track-ncds.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=track-ncds
VITE_FIREBASE_APP_ID=
# true = ต่อ Firebase Emulator Suite (ต้องรัน firebase emulators:start ก่อน)
VITE_USE_EMULATORS=false
