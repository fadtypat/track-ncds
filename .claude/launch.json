{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        "docs",
        "-p",
        "4873",
        "-c-1"
      ],
      "port": 4873
    },
    {
      "name": "web-emulator",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev:emulator",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "web-dist",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    }
  ]
}
